{
  "name": "@hmphry/brand",
  "version": "1.2.0",
  "description": "Brand design system: tokens, mark components, and primitives.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmphry/brand.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/css/styles.css",
    "./reset.css": "./dist/css/reset.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./colors.css": "./dist/css/colors.css",
    "./surface.css": "./dist/css/surface.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "rsbuild build",
    "build:lib": "rslib build && node scripts/finalize-css.mjs",
    "dev": "rsbuild",
    "preview": "rsbuild preview",
    "storybook": "storybook dev -p 6006",
    "storybook:mcp": "node .storybook/dev-mcp.mjs",
    "build-storybook": "storybook build && node .storybook/finalize-static.mjs",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "check": "npm run check-types && npm run lint && npm run lint:css",
    "check:fix": "npm run lint:fix && npm run lint:css:fix",
    "commitlint": "commitlint --from origin/main",
    "format": "biome format . --write",
    "prepare": "husky || true",
    "prepack": "npm run check && npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@phosphor-icons/react": "^2.1.10",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@rslib/core": "^1.0.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "storybook-react-rsbuild": "^3.6.2",
    "stylelint": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "22.19.0"
  }
}
